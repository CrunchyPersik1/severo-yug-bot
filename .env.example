# Токен бота от @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres (Supabase). Для Render берите Session/Transaction pooler (IPv4):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Секретный путь вебхука и заголовок X-Telegram-Bot-Api-Secret-Token.
# На Render генерируются автоматически (generateValue). Локально можно не задавать:
# тогда путь выводится из BOT_TOKEN.
WEBHOOK_SECRET=change-me-please-32-chars-min
WEBHOOK_TOKEN=change-me-please

# Публичный адрес сервиса. На Render подставляется автоматически из RENDER_EXTERNAL_URL.
PUBLIC_URL=

# Опционально: id админов через запятую (для /stats)
ADMIN_IDS=
